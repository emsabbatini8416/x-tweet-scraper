# Required public-web application bearer token. Never use a personal access token.
X_BEARER_TOKEN=

# Server-controlled entitlement store. Records are keyed by Apify runner userId.
ENTITLEMENT_STORE_ID=
ENTITLEMENT_STORE_TOKEN=

# Optional overrides when X rotates internal GraphQL operation IDs.
X_USER_BY_SCREEN_NAME_QUERY_ID=
X_USER_TWEETS_QUERY_ID=
X_TWEET_BY_ID_QUERY_ID=
