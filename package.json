{
  "name": "x-tweet-scraper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browserless Apify Actor for public X tweets",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "apify": "^3.7.2",
    "apify-client": "^2.25.0",
    "got-scraping": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
