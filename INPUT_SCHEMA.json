{
  "title": "X Tweet Scraper",
  "description": "Scrape recent public tweets from authors or hydrate tweets by ID using HTTP only.",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "fromUsers": {
      "title": "Authors",
      "type": "array",
      "description": "X usernames, with or without @.",
      "editor": "stringList",
      "default": []
    },
    "tweetIds": {
      "title": "Tweet IDs",
      "type": "array",
      "description": "Numeric tweet IDs to hydrate.",
      "editor": "stringList",
      "default": []
    },
    "searchTerms": {
      "title": "Search terms (unsupported)",
      "type": "array",
      "description": "Reserved bonus input. Runs reject this field because public search requires authentication.",
      "editor": "stringList",
      "default": []
    },
    "hashtags": {
      "title": "Hashtags",
      "type": "array",
      "editor": "stringList",
      "default": []
    },
    "since": {
      "title": "Since",
      "type": "string",
      "description": "Inclusive ISO-8601 date or timestamp.",
      "editor": "textfield"
    },
    "until": {
      "title": "Until",
      "type": "string",
      "description": "Exclusive ISO-8601 date or timestamp.",
      "editor": "textfield"
    },
    "language": {
      "title": "Language",
      "type": "string",
      "description": "Tweet language code, for example en.",
      "editor": "textfield"
    },
    "minLikes": {
      "title": "Minimum likes",
      "type": "integer",
      "minimum": 0,
      "editor": "number"
    },
    "minRetweets": {
      "title": "Minimum retweets",
      "type": "integer",
      "minimum": 0,
      "editor": "number"
    },
    "minReplies": {
      "title": "Minimum replies",
      "type": "integer",
      "minimum": 0,
      "editor": "number"
    },
    "onlyVerified": {
      "title": "Only verified authors",
      "type": "boolean",
      "default": false,
      "editor": "checkbox"
    },
    "mediaType": {
      "title": "Media type",
      "type": "string",
      "enum": ["any", "text_only", "images", "video", "links"],
      "enumTitles": ["Any", "Text only", "Images", "Video", "Links"],
      "default": "any",
      "editor": "select"
    },
    "includeReplies": {
      "title": "Include replies",
      "type": "boolean",
      "default": true,
      "editor": "checkbox"
    },
    "includeRetweets": {
      "title": "Include retweets",
      "type": "boolean",
      "default": true,
      "editor": "checkbox"
    },
    "sortBy": {
      "title": "Sort by",
      "type": "string",
      "enum": ["latest", "top"],
      "enumTitles": ["Latest", "Top"],
      "default": "latest",
      "editor": "select"
    },
    "maxResults": {
      "title": "Maximum results",
      "type": "integer",
      "minimum": 1,
      "default": 100,
      "editor": "number"
    },
    "proxyConfiguration": {
      "title": "Proxy configuration",
      "type": "object",
      "description": "Standard Apify Proxy configuration.",
      "editor": "proxy"
    }
  }
}
